#!/usr/bin/env bash
set -eo pipefail

# Bootstrap runs the macOS install script. The steps that need root source
# `script/warp_sudo` and ask for confirmation before running. Pass -y / --yes
# (or set WARP_SKIP_SUDO_PROMPT=1) to skip the prompts in unattended environments.

OS_TYPE="$(uname -s)"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
PLATFORM_ARGS=()

cd "${REPO_ROOT}"

usage() {
  cat <<EOF
Usage: ./script/bootstrap [options]

Prepare this checkout for development by running the macOS bootstrap steps.

Options:
  -h, --help               Show this help message.
  -y, --yes                Skip confirmation prompts before steps that need root.

Environment:
  WARP_SKIP_SUDO_PROMPT=1
      Same as --yes.
EOF
}

print_bootstrap_preview() {
  echo "Bootstrap is starting for macOS."
  echo "It will:"
  echo "  - Configure Xcode as the active developer directory."
  echo "  - Install or update Cargo, Homebrew, PowerShell, Docker, and related development tools."
  echo "  - Add the aarch64-apple-darwin Rust target."
  echo "Run ./script/bootstrap --help to see options and environment overrides."
  echo
}

for arg in "$@"; do
  case "${arg}" in
    -h|--help)
      usage
      exit 0
      ;;
    -y|--yes)
      export WARP_SKIP_SUDO_PROMPT=1
      PLATFORM_ARGS+=("${arg}")
      ;;
    *)
      echo "error: unknown argument '${arg}'" >&2
      echo "Run ./script/bootstrap --help to see available options." >&2
      exit 1
      ;;
  esac
done

if [[ "$OS_TYPE" != "Darwin" ]]; then
  echo "Only macOS is supported."
  exit 1
fi

print_bootstrap_preview
./script/macos/bootstrap "${PLATFORM_ARGS[@]}"
