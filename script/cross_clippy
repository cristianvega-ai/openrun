#!/usr/bin/env bash
#
# Runs the strict workspace lint for the Windows and Linux targets from any machine that has `zig`.
#
#   script/cross_clippy [windows|linux|all] [-- EXTRA_CARGO_ARGS...]
#
# It runs
#
#   cargo clippy --locked --workspace --all-targets --tests --keep-going --target <triple> -- -D warnings
#
# for x86_64-pc-windows-gnu ("windows") and x86_64-unknown-linux-gnu ("linux"); with no argument
# it runs both, one after the other, and exits non-zero if either reports a warning or an error.
# This is the cross-target gate of the definition of done. CI runs the same lint natively on
# windows-latest, macos-latest and ubuntu-latest (.github/workflows/ci.yml); this script gives
# the Windows and Linux results without a runner, for code that `cargo clippy` on a Mac does not
# compile (`cfg(windows)`, `cfg(target_os = "linux")`).
#
# Prerequisites:
#   - zig 0.12 or newer on the PATH. It provides the C and C++ compilers for the cross targets
#     (`brew install zig`, or https://ziglang.org/download/). Nothing else is needed: the build
#     scripts of the C dependencies (openh264, sqlite, zstd, ...) are compiled with `zig cc`.
#   - The Rust targets for the toolchain of rust-toolchain.toml:
#       rustup target add x86_64-pc-windows-gnu x86_64-unknown-linux-gnu
#   - Free disk space: each target builds the whole dependency tree into its own target
#     directory (about 20 GB each).
#
# Environment:
#   CROSS_CLIPPY_DIR         Where the compiler wrappers and zig's cache go
#                            (default: ${XDG_CACHE_HOME:-~/.cache}/openrun-cross-clippy).
#   CROSS_CLIPPY_TARGET_DIR  Parent of the per-target cargo target directories
#                            (default: <repo>/target/cross-clippy).
#
# Long builds: run it in the background and write the output to a file, for example
#   script/cross_clippy > cross_clippy.log 2>&1 &
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

usage() {
  sed -n '3,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

which_targets=all
if [ "$#" -gt 0 ] && [ "$1" != "--" ]; then
  case "$1" in
    windows | linux | all) which_targets=$1 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "unknown target '$1'" >&2; usage >&2; exit 2 ;;
  esac
  shift
fi
if [ "$#" -gt 0 ] && [ "$1" = "--" ]; then
  shift
fi
extra_cargo_args=("$@")

for tool in zig cargo rustup; do
  if ! command -v "$tool" > /dev/null; then
    echo "error: '$tool' is not on the PATH (see the prerequisites at the top of $0)" >&2
    exit 1
  fi
done

# `zig env` prints the library directory as ZON (zig 0.12+: `.lib_dir = "..."`) or JSON.
zig_lib_dir=$(zig env | sed -n -e 's/^ *\.lib_dir = "\(.*\)",$/\1/p' -e 's/^ *"lib_dir": *"\(.*\)",\{0,1\}$/\1/p' | head -n 1)
if [ -z "$zig_lib_dir" ] || [ ! -d "$zig_lib_dir/libc/include" ]; then
  echo "error: could not find zig's bundled libc headers (lib_dir='$zig_lib_dir')" >&2
  exit 1
fi

cross_dir=${CROSS_CLIPPY_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/openrun-cross-clippy}
target_base=${CROSS_CLIPPY_TARGET_DIR:-$repo_root/target/cross-clippy}
mkdir -p "$cross_dir/bin" "$cross_dir/zig-cache" "$cross_dir/zig-cache-local"

# `zig cc` rejects the `--target=<triple>` flag that cc-rs passes, and wants `-target` in zig's
# own spelling, so each wrapper drops the former and adds the latter.
write_wrapper() { # name zig-subcommand zig-target
  local file="$cross_dir/bin/$1"
  cat > "$file" << EOF
#!/bin/sh
export ZIG_GLOBAL_CACHE_DIR='$cross_dir/zig-cache'
export ZIG_LOCAL_CACHE_DIR='$cross_dir/zig-cache-local'
n=\$#
while [ "\$n" -gt 0 ]; do
  arg=\$1
  shift
  n=\$((n - 1))
  case "\$arg" in
    --target=*) ;;
    *) set -- "\$@" "\$arg" ;;
  esac
done
exec zig $2 -target $3 "\$@"
EOF
  chmod +x "$file"
}
write_wrapper zig-windows-cc cc x86_64-windows-gnu
write_wrapper zig-windows-cxx c++ x86_64-windows-gnu
write_wrapper zig-linux-cc cc x86_64-linux-gnu
write_wrapper zig-linux-cxx c++ x86_64-linux-gnu
cat > "$cross_dir/bin/zig-ar" << 'EOF'
#!/bin/sh
exec zig ar "$@"
EOF
chmod +x "$cross_dir/bin/zig-ar"

# Fail early, with the fix, if the Rust target is missing for the pinned toolchain.
installed_targets=$(rustup target list --installed)

clippy_for() { # windows|linux
  local name=$1 triple
  case "$name" in
    windows)
      triple=x86_64-pc-windows-gnu
      export BINDGEN_EXTRA_CLANG_ARGS_x86_64_pc_windows_gnu="--target=x86_64-pc-windows-gnu -isystem $zig_lib_dir/include -isystem $zig_lib_dir/libc/include/any-windows-any -isystem $zig_lib_dir/libc/include/x86_64-windows-gnu"
      export CC_x86_64_pc_windows_gnu=$cross_dir/bin/zig-windows-cc
      export CXX_x86_64_pc_windows_gnu=$cross_dir/bin/zig-windows-cxx
      export AR_x86_64_pc_windows_gnu=$cross_dir/bin/zig-ar
      ;;
    linux)
      triple=x86_64-unknown-linux-gnu
      export BINDGEN_EXTRA_CLANG_ARGS_x86_64_unknown_linux_gnu="--target=x86_64-unknown-linux-gnu -isystem $zig_lib_dir/include -isystem $zig_lib_dir/libc/include/x86-linux-gnu -isystem $zig_lib_dir/libc/include/generic-glibc -isystem $zig_lib_dir/libc/include/x86-linux-any -isystem $zig_lib_dir/libc/include/any-linux-any"
      export CC_x86_64_unknown_linux_gnu=$cross_dir/bin/zig-linux-cc
      export CXX_x86_64_unknown_linux_gnu=$cross_dir/bin/zig-linux-cxx
      export AR_x86_64_unknown_linux_gnu=$cross_dir/bin/zig-ar
      ;;
  esac
  if ! grep -qx "$triple" <<< "$installed_targets"; then
    echo "error: the Rust target $triple is not installed for this toolchain; run: rustup target add $triple" >&2
    return 1
  fi
  # openh264 would assemble with NASM; a lint run does not need the object code.
  export OPENH264_NO_ASM=1
  export PKG_CONFIG_ALLOW_CROSS=1
  export CARGO_TARGET_DIR="$target_base/$name"
  echo "== cargo clippy --target $triple (target dir: $CARGO_TARGET_DIR)"
  cargo clippy --locked --workspace --all-targets --tests --keep-going \
    --target "$triple" ${extra_cargo_args[@]+"${extra_cargo_args[@]}"} -- -D warnings
}

status=0
case "$which_targets" in
  windows) clippy_for windows || status=$? ;;
  linux) clippy_for linux || status=$? ;;
  all)
    clippy_for windows || status=$?
    clippy_for linux || status=$?
    ;;
esac
if [ "$status" -ne 0 ]; then
  echo "cross_clippy: FAILED (exit $status)" >&2
else
  echo "cross_clippy: clean"
fi
exit "$status"
