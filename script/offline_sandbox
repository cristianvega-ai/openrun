#!/usr/bin/env bash
# Runs a command in a network sandbox and records every connect and send it makes.
#
#   script/offline_sandbox LOG COMMAND [ARG...]
#
# The command runs in a fresh user and network namespace whose only interface is the loopback one,
# so a non-loopback connection fails. `strace` writes each connect, sendto, sendmsg and sendmmsg of
# the command and its children to LOG (and each program they start, to tell who made a call); `script/offline_audit --net-log LOG` turns that log into a
# pass or fail. Needs Linux, `unshare` and `ip` (iproute2) and `strace`. Used by the
# `offline-audit` job in .github/workflows/ci.yml.
#
# `--seccomp-bpf` makes `strace` stop the command only at the traced calls. Without it, every
# system call of every process is a ptrace stop. That made the shell bootstrap of the integration
# tests (bash reads a long script one byte at a time from the pty) take 20 s instead of under 1 s.
#
# `strace` 6.8 (Ubuntu 24.04) sometimes dies on its own, in the middle of a run, with
# `strace: ptrace(PTRACE_LISTEN,pid:N,sig:0): Input/output error`: a traced process that the tests
# kill (the app kills the process groups of the commands it started) races with the tracer's
# handling of its group-stop. The tracee processes die with the tracer, so the run is lost
# although no test failed. When that message is the reason the command ended, the command is
# started again (at most 3 runs), a warning annotation names it, and the connections of every run
# are kept in LOG. A command that fails for any other reason is not run again.
#
# Environment (for testing the script): OFFLINE_SANDBOX_STRACE is the tracer to run (default
# `strace`), OFFLINE_SANDBOX_NO_NAMESPACE=1 runs without `unshare` and `ip` and
# OFFLINE_SANDBOX_GRACE is the number of seconds `strace` may outlive the command (default 30).
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "usage: $0 LOG COMMAND [ARG...]" >&2
  exit 2
fi

# Prints, as a warning annotation, the processes that `strace` still traces, found through the
# `TracerPid` of /proc/PID/status, and ends them. `strace` does not exit while one of them lives.
end_stragglers() {
  local tracer=$1 pid status_file
  local -a stragglers=()
  for status_file in /proc/[0-9]*/status; do
    pid=${status_file#/proc/}
    pid=${pid%/status}
    if [ "$(awk '/^TracerPid:/ { print $2 }' "$status_file" 2> /dev/null)" = "$tracer" ]; then
      stragglers+=("$pid")
    fi
  done
  echo "::warning title=sandbox stragglers::the command ended but strace ($tracer) is still tracing ${#stragglers[@]} process(es); they are listed below and ended"
  if [ "${#stragglers[@]}" -gt 0 ]; then
    ps -o pid,ppid,pgid,sid,stat,etime,args -p "$(IFS=,; echo "${stragglers[*]}")" >&2 || true
    kill -KILL "${stragglers[@]}" 2> /dev/null || true
  fi
}

# Runs the command under `strace` and waits for `strace`. The command runs in a small wrapper that
# records its exit status in a file, so that the end of the command is known even if `strace`
# lingers: `strace` exits only when every process it traces has exited, and a process the command
# left behind (a display server, a shell, a helper) keeps the step from ending, and with it the
# log from being written. When `strace` is still there OFFLINE_SANDBOX_GRACE seconds (default 30)
# after the command ended, the processes it traces are listed and ended; if it is still there 10
# seconds later it is ended too, and the exit status of the command is the result.
run_traced() {
  local log=$1
  shift
  local strace_bin=${OFFLINE_SANDBOX_STRACE:-strace}
  local grace=${OFFLINE_SANDBOX_GRACE:-30}
  local max_runs=3
  local errors ended
  errors=$(mktemp)
  ended=$(mktemp)
  local status=0 run

  for run in $(seq 1 "$max_runs"); do
    : > "$errors"
    : > "$ended"
    # The tracer's own messages share stderr with the command; the copy in a file tells them apart
    # afterwards and the `tail` shows them as they come.
    tail -n +1 -f "$errors" >&2 &
    local mirror=$!
    export OFFLINE_SANDBOX_ENDED=$ended
    # shellcheck disable=SC2016 # The wrapper script is meant to expand its own variables.
    "$strace_bin" --seccomp-bpf -f -qq -e trace=connect,sendto,sendmsg,sendmmsg,execve \
      -o "$log.run$run" \
      sh -c 'status=0; "$@" || status=$?; echo "$status" > "$OFFLINE_SANDBOX_ENDED"; exit "$status"' \
      sh "$@" 2>> "$errors" &
    local tracer=$!

    local waited=0 forced=0
    while kill -0 "$tracer" 2> /dev/null; do
      if [ -s "$ended" ]; then
        waited=$((waited + 1))
        if [ "$waited" -eq "$grace" ]; then
          end_stragglers "$tracer"
          forced=1
        elif [ "$waited" -eq $((grace + 10)) ]; then
          echo "::warning title=sandbox stragglers::strace did not exit after its processes were ended; ending it" >&2
          kill -TERM "$tracer" 2> /dev/null || true
        elif [ "$waited" -eq $((grace + 15)) ]; then
          kill -KILL "$tracer" 2> /dev/null || true
        fi
      fi
      sleep 1
    done
    status=0
    wait "$tracer" || status=$?
    if [ "$forced" -eq 1 ] && [ -s "$ended" ]; then
      status=$(cat "$ended")
    fi
    sleep 1
    kill "$mirror" 2> /dev/null || true
    wait "$mirror" 2> /dev/null || true

    if [ "$status" -eq 0 ] || ! grep -q '^strace: ptrace(PTRACE_[A-Z_]*,.*Input/output error' "$errors"; then
      break
    fi
    if [ "$run" -lt "$max_runs" ]; then
      echo "::warning title=strace crashed::run $run of $max_runs: the tracer died with a ptrace I/O error (exit $status), which is not a test result; running the command again"
    else
      echo "::error title=strace crashed::run $run of $max_runs: the tracer died with a ptrace I/O error (exit $status) again; giving up"
    fi
  done

  cat "$log".run* > "$log"
  rm -f "$log".run* "$errors" "$ended"
  return "$status"
}

if [ "${OFFLINE_SANDBOX_INNER:-}" = 1 ]; then
  if [ -z "${OFFLINE_SANDBOX_NO_NAMESPACE:-}" ]; then
    ip link set lo up
  fi
  log=$1
  shift
  run_traced "$log" "$@"
  exit $?
fi

if [ -n "${OFFLINE_SANDBOX_NO_NAMESPACE:-}" ]; then
  OFFLINE_SANDBOX_INNER=1 exec "$0" "$@"
fi
OFFLINE_SANDBOX_INNER=1 exec unshare --user --map-root-user --net "$0" "$@"
