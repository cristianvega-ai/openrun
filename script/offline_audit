#!/usr/bin/env python3
"""Static audit that keeps the fork offline.

Runs three groups of checks over the working tree:

  hosts    Warp-owned hosts, services and build hooks: zero tolerance outside the allowlist.
  network  Network-capable code: every hit must belong to an allowed consumer.
  deps     Cargo dependency graph: banned workspace crates, banned external crates, wrapper
           rules, and `cargo deny check bans licenses sources`.

Modes:

  script/offline_audit            Strict: exit 1 if any check has findings.
  script/offline_audit --report   List every finding and exit 0.
  script/offline_audit --net-log net.log [more.log ...]
                                  Check the logs of sandboxed runs (made by
                                  script/offline_sandbox_macos, see the sandboxed jobs in
                                  .github/workflows/ci.yml): fail on any refused network access of
                                  the run's processes, on a missing, incomplete or unreadable log,
                                  and on a log whose canary is missing.
  script/offline_audit --self-test
                                  Run the checks against small fixture trees: each prohibited
                                  construct must produce a finding and each reviewed one must pass.
                                  Guards the checks themselves against going blind.

Allowed exceptions live in script/offline_audit.allowlist, one reasoned entry per line. An entry
that matches nothing fails the audit, so the list shrinks with the code it covers. Requires
python3 (3.9 or newer), ripgrep, and for the deps group cargo and cargo-deny.

The network group also reads the source of every git dependency (found with `cargo metadata`):
the completion generators of `warp-command-signatures` are shell commands the app runs, so their
sources are checked like our own, and each generator must be classified in
crates/warp_completer/src/signatures/legacy/generator_policy/.
"""

import argparse
import collections
import fnmatch
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_ALLOWLIST = os.path.join(ROOT, "script", "offline_audit.allowlist")
DENY_TOML = os.path.join(ROOT, "deny.toml")

MAX_TEXT = 200

# Set from --include-comments. Comment lines in the network check are skipped by default: prose
# about websockets or `Hyper` the terminal is not network-capable code.
INCLUDE_COMMENTS = False

HOST_PATTERNS = [
    r"warp\.dev", r"warpdotdev", r"warp-server", r"warp_server", r"app\.warp", r"oz\.warp",
    r"releases\.warp", r"gs://warp", r"warp-static-assets", r"storage\.googleapis\.com",
    r"firebase", r"identitytoolkit", r"securetoken", r"AIza[0-9A-Za-z_-]{35}",
    r"sentry", r"rudder", r"segment\.(io|com)", r"typeform", r"warpcommunity\.slack",
    r"linear\.app/", r"download/cli", r"channel_versions", r"WARP_LOCAL_SKIP_METAL",
    # Hosts of the removed AI features, cloud storage and telemetry vendors: none may come back.
    r"openrouter\.ai", r"\bx\.ai\b", r"openai\.com", r"anthropic\.com", r"terminaltrove",
    r"amazonaws\.com", r"docs\.aws\.amazon\.com", r"cloudfront\.net", r"googleapis\.com",
    r"gstatic\.com", r"google-analytics", r"googletagmanager", r"cloudfunctions\.net",
    r"\.run\.app\b", r"appspot\.com", r"mixpanel", r"amplitude\.com", r"datadoghq",
    r"posthog", r"bugsnag", r"launchdarkly", r"statsig", r"honeycomb\.io",
    # Warp-internal design docs, TDDs and debugging notes: none may be linked from the code.
    r"notion\.so", r"figma\.com", r"docs\.google\.com",
]

REVIEW_PATTERNS = [
    "oz", "warp drive", "agent mode", "warp ai", "ambient", "cloud agent", "shared session",
    "telemetry", "autoupdate", "referral", "billing",
]

# `hyper` and `websocket` are matched as whole words or with their crate suffixes so that
# `hyperlink` and `WebSocket`-free prose do not drown the list.
NETWORK_RUST_PATTERNS = [
    r"reqwest", r"http_client", r"\bhyper(_util|_rustls)?\b", r"tungstenite", r"(?i:websocket)",
    r"TcpStream", r"TcpListener", r"UdpSocket", r"tokio::net", r"std::net::", r"url_source",
    r"axum", r"opentelemetry_otlp",
]

# Subprocesses that can reach a network. Every hit needs an allowlist entry for its file (check id
# `net-cmd`): `git` and `gh` run against the user's own remotes and repositories, only while a pull
# request chip (in no default layout) or the code-review panel is showing, or on an explicit user
# action (push, create a pull request); `ssh` is the user's own SSH session.
COMMAND_PATTERN = (
    r'Command::new\("(curl|wget|git|gh|npm|npx|pip3?|go|brew|apt(-get)?|yum|dnf|pacman'
    r'|ssh|scp|sftp|nc|ncat|netcat|telnet|ftp|rsync|socat)"'
)

# A network tool at the start of a string literal or after a shell separator, such as the
# argument of `sh -c`. Test files are skipped: their fixtures name plenty of commands.
NET_STRING_PATTERN = (
    r'"(?:[^"\\]*[;&|(]\s*)?(?:command\s+)?(?:curl|wget|nc|ncat|netcat|telnet|rsync|scp|sftp|ssh|socat'
    r'|npx -y|gh api)[\s{]'
)

# Remote git operations. Only `push` is allowed, in `app/src/util/git.rs` (an explicit user action);
# `fetch`, `pull`, `clone` and `ls-remote` must not be started by the app at all. Matches the verb
# as an element of an argument array and as a `.arg("verb")` call.
GIT_REMOTE_PATTERN = r'(?:\[|\.arg\()\s*"(fetch|pull|clone|ls-remote|push|remote)"\s*[,\])]'

# The `gh` subcommands the app may run (`gh repo view`, `gh pr view`, `gh pr create`). In a file that
# starts `gh`, an argument array that begins with a `gh` command must be one of these.
GH_COMMANDS = {
    "api", "auth", "repo", "pr", "issue", "run", "workflow", "release", "gist", "secret",
    "ssh-key", "extension", "codespace", "search", "browse", "label", "cache", "ruleset",
    "variable", "org", "alias", "config", "project", "attestation",
}
ALLOWED_GH_VERBS = {("repo", "view"), ("pr", "view"), ("pr", "create")}

# Sockets bound to every interface. Never allowed without a reasoned exception (check id `net-bind`).
UNSPECIFIED_ADDR_PATTERNS = [
    r"0\.0\.0\.0", r"UNSPECIFIED", r"\[0, ?0, ?0, ?0\]", r"Ipv4Addr::new\(0, ?0, ?0, ?0\)",
    r'"::"', r"\[::\]",
]
# Every TCP/UDP bind must name a loopback address within this many characters.
BIND_PATTERN = r"(?:TcpListener|UdpSocket)::bind\("
LOOPBACK_MARKERS = ("127.0.0.1", "127, 0, 0, 1", "LOCALHOST", "localhost", "::1")
BIND_WINDOW = 240

# Crates that may fetch or serve: a URL literal in their non-test sources needs a `net-url` entry.
NET_URL_SCOPE = [
    "crates/http_client", "crates/node_runtime", "crates/lsp", "crates/local_control",
    "app/src/local_control",
]

SCRIPT_PATTERNS = [
    r"curl ", r"wget ", r"Invoke-WebRequest", r"Invoke-RestMethod", r"\biwr ", r"\bnc ", r"\bncat ",
    r"\bsocat ", r"urllib", r"urlopen", r"/dev/tcp/", r"Net::HTTP",
]
SCRIPT_DIRS = ["app/assets", "resources", "script", "docker"]

# Network-capable text in git dependencies. URLs are not searched there (doc comments are full of
# them) except inside the completion generators, whose strings are commands.
DEP_CODE_PATTERNS = NETWORK_RUST_PATTERNS + [COMMAND_PATTERN, NET_STRING_PATTERN]
# Directories that a dependency's build script writes into its own source checkout. They exist only
# in a checkout that has been built (a cached one in CI, a fresh one on a clean runner), so searching
# them would make the result depend on the build state. `warp-workflows` generates Rust from its
# committed YAML specs into `src/generated_workflows/`; the texts are commands for the user's shell
# and the app never runs them.
DEP_BUILD_OUTPUT_GLOBS = ["!**/generated_workflows/**"]
DEP_GENERATOR_URL_PATTERN = r"https?://[A-Za-z0-9]"
GENERATOR_DEP = "warp-command-signatures"
GENERATOR_POLICY_DIR = "crates/warp_completer/src/signatures/legacy/generator_policy"

LINK_PATTERNS = [r"open_url\(", r"hyperlink\(", r"with_href\(", r"OpenLink"]

URL_LITERAL = r"https?://[A-Za-z0-9][A-Za-z0-9._-]*"

# Workspace packages that must not exist. A trailing `*` matches any suffix.
BANNED_WORKSPACE_PACKAGES = [
    "ai", "mcp", "computer_use", "warp_multi_agent_client", "warp_server_client",
    "warp_server_auth", "graphql", "warp_graphql", "warp_graphql_schema", "firebase", "websocket",
    "cloud_object*", "cloud_objects", "managed_secrets*", "warp_managed_secrets*",
    "remote_server", "app-installation-detection", "http_server", "serve-wasm",
    "warp_channel_config", "warp_web_event_bus", "warp_harness_usage", "isolation_platform",
    "warp_isolation_platform", "channel_versions", "warp_tui",
]


class Finding(object):
    def __init__(self, path, line, text):
        self.path = path
        self.line = line
        self.text = text


class Result(object):
    def __init__(self, check_id, title, blocking=True):
        self.check_id = check_id
        self.title = title
        self.blocking = blocking
        self.findings = []
        self.notes = []
        self.skipped = None

    def add(self, path, line, text):
        if path is None or not any(f.path == path and f.line == line for f in self.findings):
            self.findings.append(Finding(path, line, text))


class Allowlist(object):
    """Entries are `check | path glob | line regex or * | reason`, `#` starts a comment.

    Fields are separated by a pipe with spaces around it, so a regex must not contain ` | `.

    `binary-pin` entries pin a binary file: the glob is its exact path and the regex field is the
    lowercase SHA-256 of its content. Pinned files are not searched; the hash is verified instead."""

    def __init__(self, path=None, lines=None):
        self.entries = []
        self.used = set()
        source = "allowlist"
        if lines is None:
            source = path
            if not path or not os.path.exists(path):
                return
            with open(path, encoding="utf-8") as f:
                lines = f.read().splitlines()
        for number, raw in enumerate(lines, 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in re.split(r"\s+\|\s+", line, maxsplit=3)]
            if len(parts) != 4 or not parts[3]:
                sys.exit("%s:%d: expected `check | path glob | regex or * | reason`" % (source, number))
            check, glob, regex, _reason = parts
            if check == "binary-pin" and (
                "*" in glob or not re.fullmatch(r"[0-9a-f]{64}", regex)
            ):
                sys.exit("%s:%d: binary-pin needs an exact path and a lowercase sha256" % (source, number))
            compiled = None if regex == "*" else re.compile(regex, re.IGNORECASE)
            self.entries.append((check, glob, compiled, number))

    def allows(self, check, path, text):
        for index, (entry_check, glob, regex, _number) in enumerate(self.entries):
            if entry_check != check:
                continue
            if not fnmatch.fnmatch(path, glob):
                continue
            if regex is not None and not regex.search(text):
                continue
            self.used.add(index)
            return True
        return False

    def pins(self):
        """Returns [(index, path, sha256)] of the `binary-pin` entries."""
        return [
            (index, glob, regex.pattern)
            for index, (check, glob, regex, _number) in enumerate(self.entries)
            if check == "binary-pin"
        ]

    def unused(self):
        return [
            (check, glob, number)
            for index, (check, glob, _regex, number) in enumerate(self.entries)
            if index not in self.used
        ]


def run(cmd, cwd=None, check=False):
    env = dict(os.environ)
    proc = subprocess.run(cmd, cwd=cwd or ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check and proc.returncode != 0:
        raise RuntimeError("%s failed:\n%s" % (" ".join(cmd), proc.stderr.decode("utf-8", "replace")))
    return proc


def rg_lines(args, paths=None):
    """Runs ripgrep and yields (path, line number, text). Exit code 1 means no matches."""
    cmd = [
        "rg", "--no-heading", "--with-filename", "--line-number", "--null", "--color=never",
        "--max-columns=400", "--max-columns-preview", "--no-messages", "--no-ignore-global", "--no-ignore-parent",
    ] + args + ["--"] + (paths or ["."])
    proc = run(cmd)
    if proc.returncode not in (0, 1):
        raise RuntimeError("rg failed (%d): %s" % (proc.returncode, proc.stderr.decode("utf-8", "replace")))
    for raw in proc.stdout.decode("utf-8", "replace").splitlines():
        path, separator, rest = raw.partition("\0")
        match = re.match(r"^(\d+)[:-](.*)$", rest)
        if not separator or not match:
            continue
        if path.startswith("./"):
            path = path[2:]
        yield path, int(match.group(1)), match.group(2).replace("\0", "")


def pattern_args(patterns):
    args = []
    for pattern in patterns:
        args += ["-e", pattern]
    return args


def clip(text, regex=None):
    text = text.strip()
    unprintable = sum(1 for c in text if not (c.isprintable() or c == "\t"))
    if regex is not None and unprintable * 10 > len(text):
        match = regex.search(text)
        if match:
            start = max(0, match.start() - 30)
            return "[binary] ..." + re.sub(r"[^ -~]", ".", text[start:match.end() + 30]) + "..."
    return text if len(text) <= MAX_TEXT else text[:MAX_TEXT] + "..."


def area(path):
    """Coarse ownership bucket for the summary: crate, or app/src module, or top-level dir."""
    parts = path.split("/")
    if parts[0] == "crates" and len(parts) > 1:
        return "crates/" + parts[1]
    if parts[0] == "app" and len(parts) > 2:
        if parts[1] == "src" and len(parts) > 3:
            return "app/src/" + parts[2]
        return "app/" + parts[1]
    return parts[0]


# --- 9.1 ---------------------------------------------------------------------------------


def check_hosts(allow):
    result = Result("hosts", "Warp-owned hosts and services (9.1)")
    pinned = allow.pins()
    args = ["-i", "-a", "--hidden", "-g", "!.git", "-g", "!target"]
    for _index, path, _digest in pinned:
        args += ["-g", "!" + path]
    args += pattern_args(HOST_PATTERNS)
    regex = re.compile("|".join(HOST_PATTERNS), re.IGNORECASE)
    for path, line, text in rg_lines(args):
        if allow.allows("hosts", path, text):
            continue
        result.add(path, line, clip(text, regex))
    for index, path, digest in pinned:
        full = os.path.join(ROOT, path)
        if not os.path.isfile(full):
            result.add(path, None, "pinned binary is missing")
            continue
        with open(full, "rb") as f:
            actual = hashlib.sha256(f.read()).hexdigest()
        allow.used.add(index)
        if actual != digest:
            result.add(path, None, "pinned binary changed: sha256 %s, pinned %s" % (actual, digest))
    return result


def check_review(_allow):
    result = Result("review", "Review list: removed-feature wording (9.1, informational)", blocking=False)
    args = ["-i", "-w", "-t", "rust", "-t", "md", "-t", "toml", "-g", "!target"] + pattern_args(REVIEW_PATTERNS)
    compiled = [(p, re.compile(r"\b" + re.escape(p) + r"\b", re.IGNORECASE)) for p in REVIEW_PATTERNS]
    per_pattern = collections.Counter()
    for path, line, text in rg_lines(args):
        for pattern, regex in compiled:
            if regex.search(text):
                per_pattern[pattern] += 1
        result.add(path, line, clip(text))
    result.notes.append(
        "hits per pattern: " + ", ".join("%s=%d" % (p, per_pattern[p]) for p, _ in compiled)
    )
    return result


# --- 9.2 ---------------------------------------------------------------------------------


def is_comment(text):
    return text.lstrip().startswith("//") and not INCLUDE_COMMENTS


def is_test_path(path):
    name = os.path.basename(path)
    return (
        name.endswith("_tests.rs") or name in ("test.rs", "tests.rs")
        or "/tests/" in path or "/testing/" in path
    )


NON_TEST_GLOBS = ["-g", "!*_tests.rs", "-g", "!**/tests/**", "-g", "!**/testing/**",
                  "-g", "!**/test.rs", "-g", "!**/tests.rs"]


def check_network(allow):
    result = Result("network", "Network-capable code (9.2)")
    args = ["-t", "rust", "-g", "!target"]

    for path, line, text in rg_lines(args + pattern_args(NETWORK_RUST_PATTERNS)):
        if is_comment(text):
            continue
        if not allow.allows("net-rust", path, text):
            result.add(path, line, clip(text))

    allowed_commands = collections.Counter()
    command_regex = re.compile(COMMAND_PATTERN)
    for path, line, text in rg_lines(args + ["-e", COMMAND_PATTERN]):
        if is_comment(text):
            continue
        if allow.allows("net-cmd", path, text):
            allowed_commands[command_regex.search(text).group(1)] += 1
        else:
            result.add(path, line, clip(text))
    if allowed_commands:
        result.notes.append(
            "reviewed subprocesses (only while their UI is in use, or on user action): "
            + ", ".join("%s x%d" % item for item in sorted(allowed_commands.items()))
        )

    for path, line, text in rg_lines(args + NON_TEST_GLOBS + ["-e", NET_STRING_PATTERN]):
        if is_comment(text):
            continue
        if not allow.allows("net-string", path, text):
            result.add(path, line, clip(text))

    for path, line, text in rg_lines(args + ["-e", GIT_REMOTE_PATTERN]):
        if is_comment(text):
            continue
        if not allow.allows("net-git", path, text):
            result.add(path, line, clip(text))

    check_gh_verbs(result)
    check_binds(allow, result)
    check_net_urls(allow, result)

    script_paths = [d for d in SCRIPT_DIRS if os.path.exists(os.path.join(ROOT, d))]
    if script_paths:
        for path, line, text in rg_lines(["--hidden", "-g", "!.git"] + pattern_args(SCRIPT_PATTERNS), script_paths):
            if text.lstrip().startswith("#") and not INCLUDE_COMMENTS:
                continue
            if not allow.allows("net-script", path, text):
                result.add(path, line, clip(text))
    return result


def rust_files_containing(pattern):
    proc = run(["rg", "--files-with-matches", "--no-messages", "--no-ignore-global", "--no-ignore-parent",
                "-t", "rust", "-g", "!target", "-e", pattern, "--", "."])
    return sorted(p[2:] if p.startswith("./") else p for p in proc.stdout.decode("utf-8", "replace").split())


def check_gh_verbs(result):
    """In a file that starts `gh`, every argument array that begins with a `gh` command must be one of
    ALLOWED_GH_VERBS, so `gh api` and friends cannot appear next to the reviewed calls."""
    array = re.compile(r'\[\s*"([a-z][a-z-]*)"\s*(?:,\s*"([a-z][a-z-]*)")?')
    for path in rust_files_containing(r'Command::new\("gh"\)'):
        with open(os.path.join(ROOT, path), encoding="utf-8", errors="replace") as f:
            for number, text in enumerate(f, 1):
                for match in array.finditer(text):
                    command, sub = match.group(1), match.group(2)
                    if command in GH_COMMANDS and (command, sub) not in ALLOWED_GH_VERBS:
                        result.add(path, number, "gh %s %s is not one of the reviewed gh commands" % (command, sub or ""))


def check_binds(allow, result):
    """Sockets: no bind to every interface, and every TCP/UDP bind names a loopback address."""
    unspecified = re.compile("|".join(UNSPECIFIED_ADDR_PATTERNS))
    for path, line, text in rg_lines(["-t", "rust", "-g", "!target"] + pattern_args(UNSPECIFIED_ADDR_PATTERNS)):
        if is_comment(text):
            continue
        if unspecified.search(text) and not allow.allows("net-bind", path, text):
            result.add(path, line, clip(text) + "  [address of every interface]")
    bind = re.compile(BIND_PATTERN)
    for path in rust_files_containing(BIND_PATTERN):
        if is_test_path(path):
            continue
        with open(os.path.join(ROOT, path), encoding="utf-8", errors="replace") as f:
            content = f.read()
        for match in bind.finditer(content):
            line = content.count("\n", 0, match.start()) + 1
            text = content.splitlines()[line - 1]
            window = content[match.start():match.start() + BIND_WINDOW]
            if any(marker in window for marker in LOOPBACK_MARKERS):
                continue
            if not allow.allows("net-bind", path, text):
                result.add(path, line, clip(text) + "  [bind without a loopback address]")


def check_net_urls(allow, result):
    """URL literals in the crates that may fetch or serve name the destinations we talk to."""
    scope = [d for d in NET_URL_SCOPE if os.path.exists(os.path.join(ROOT, d))]
    if not scope:
        return
    for path, line, text in rg_lines(["-t", "rust", "-g", "!target"] + NON_TEST_GLOBS + ["-e", URL_LITERAL], scope):
        if is_comment(text) or text.lstrip().startswith(("///", "//!", "*")):
            continue
        if not allow.allows("net-url", path, text):
            result.add(path, line, clip(text))


# --- git dependencies -----------------------------------------------------------------------


def cargo_metadata():
    for extra in (["--offline"], []):
        proc = run(["cargo", "metadata", "--format-version", "1", "--locked", "--all-features"] + extra)
        if proc.returncode == 0:
            return json.loads(proc.stdout)
    raise RuntimeError("cargo metadata failed:\n" + proc.stderr.decode("utf-8", "replace"))


def git_dependency_dirs(meta):
    """Returns [(package name, source directory)] for every package that comes from a git source."""
    found = collections.OrderedDict()
    for package in sorted(meta["packages"], key=lambda p: p["name"]):
        if (package.get("source") or "").startswith("git+"):
            found.setdefault(os.path.dirname(package["manifest_path"]), package["name"])
    return [(name, directory) for directory, name in found.items()]


def parse_policy_pairs(path):
    """Returns the set of (spec, generator) string pairs listed in a generator_policy source file."""
    with open(path, encoding="utf-8") as f:
        return set(re.findall(r'^\s*\(\s*"([^"]+)"\s*,\s*"([^"]+)"', f.read(), re.M))


def generator_names_in_source(directory):
    """Returns {generator name: (path, line)} for every `.add_generator(NAME, ...)` in a generators dir.
    Names given as a `const NAME: &str` of the same file are resolved."""
    names = {}
    unresolved = []
    for path in sorted(glob_rs(directory)):
        with open(path, encoding="utf-8", errors="replace") as f:
            content = f.read()
        consts = dict(re.findall(r'const (\w+): &str = "([^"]+)"', content))
        for match in re.finditer(r'\.add_generator\(\s*(?:GeneratorName::new\(\s*)?("([^"]+)"|(\w+))', content):
            line = content.count("\n", 0, match.start()) + 1
            name = match.group(2) or consts.get(match.group(3))
            if name is None:
                unresolved.append((path, line, match.group(3)))
            else:
                names.setdefault(name, (path, line))
    return names, unresolved


def glob_rs(directory):
    for base, _dirs, files in os.walk(directory):
        for name in files:
            if name.endswith(".rs") and not name.endswith("_tests.rs"):
                yield os.path.join(base, name)


def check_dependency_sources(allow, dependencies=None, policy_dir=None):
    """Network-capable text in git dependencies, and the classification of completion generators."""
    result = Result("depsrc", "Git dependency sources (9.2)")
    if dependencies is None:
        dependencies = git_dependency_dirs(cargo_metadata())
    code_args = ["-t", "rust", "--no-messages"] + NON_TEST_GLOBS + [
        "-g", "!**/examples/**", "-g", "!**/benches/**",
    ]
    for glob in DEP_BUILD_OUTPUT_GLOBS:
        code_args += ["-g", glob]
    code_args += pattern_args(DEP_CODE_PATTERNS)
    for name, directory in dependencies:
        for path, line, text in rg_lines(code_args, [directory]):
            if is_comment(text):
                continue
            relative = "git-dep:%s/%s" % (name, os.path.relpath(path, directory)) if os.path.isabs(path) else path
            if not allow.allows("net-dep", relative, text):
                result.add(relative, line, clip(text))
        if name == GENERATOR_DEP:
            generators = os.path.join(directory, "command-signatures", "src", "generators")
            if not os.path.isdir(generators):
                generators = os.path.join(directory, "src", "generators")
            check_generator_sources(
                allow, result, name, directory, generators, policy_dir or os.path.join(ROOT, GENERATOR_POLICY_DIR)
            )
    return result


def check_generator_sources(allow, result, name, directory, generators, policy_dir):
    if not os.path.isdir(generators):
        result.add(None, None, "%s: no generators directory at %s" % (name, generators))
        return
    for path, line, text in rg_lines(["-t", "rust", "--no-messages"] + NON_TEST_GLOBS + ["-e", DEP_GENERATOR_URL_PATTERN], [generators]):
        if is_comment(text):
            continue
        relative = "git-dep:%s/%s" % (name, os.path.relpath(path, directory))
        if not allow.allows("net-dep", relative, text):
            result.add(relative, line, clip(text))
    classified = set()
    for filename in ("allowed.rs", "denied.rs"):
        listed = os.path.join(policy_dir, filename)
        if not os.path.exists(listed):
            result.add(None, None, "generator policy list %s is missing" % listed)
            return
        classified |= {generator for _spec, generator in parse_policy_pairs(listed)}
    names, unresolved = generator_names_in_source(generators)
    for path, line, argument in unresolved:
        result.add(os.path.relpath(path, generators), line, "generator name `%s` cannot be resolved statically" % argument)
    for generator, (path, line) in sorted(names.items()):
        if generator not in classified:
            result.add(
                "git-dep:%s/%s" % (name, os.path.basename(path)), line,
                "generator `%s` is in neither allowed.rs nor denied.rs (%s)" % (generator, GENERATOR_POLICY_DIR),
            )


def check_links(_allow):
    result = Result("links", "Browser-opening call sites (9.2, informational)", blocking=False)
    for path, line, text in rg_lines(["-t", "rust", "-g", "!target"] + pattern_args(LINK_PATTERNS)):
        result.add(path, line, clip(text))
    return result


def check_url_hosts(_allow):
    result = Result("urls", "Hard-coded URL hosts in Rust sources (informational)", blocking=False)
    per_host = collections.defaultdict(list)
    for path, line, text in rg_lines(["-t", "rust", "-g", "!target", "-o", "-e", URL_LITERAL]):
        host = re.sub(r"^https?://", "", text.strip()).lower()
        per_host[host].append((path, line))
    for host in sorted(per_host):
        locations = per_host[host]
        files = sorted(set(p for p, _ in locations))
        result.add(None, None, "%-42s %4d in %3d files, e.g. %s:%d" % (host, len(locations), len(files), files[0], locations[0][1]))
    return result


# --- 9.3 ---------------------------------------------------------------------------------


def parse_deny_bans():
    """Returns {crate: wrappers or None} from the `bans.deny` entries of deny.toml."""
    with open(DENY_TOML, encoding="utf-8") as f:
        text = f.read()
    section = re.search(r"^\[bans\](.*?)(?=^\[|\Z)", text, re.S | re.M)
    if not section:
        raise RuntimeError("deny.toml has no [bans] section")
    bans = {}
    for entry in re.finditer(r'\{\s*crate\s*=\s*"([^"]+)"([^}]*)\}', section.group(1)):
        wrappers = re.search(r"wrappers\s*=\s*\[([^\]]*)\]", entry.group(2))
        bans[entry.group(1)] = re.findall(r'"([^"]+)"', wrappers.group(1)) if wrappers else None
    return bans


def load_graph():
    proc = run(["cargo", "metadata", "--format-version", "1", "--locked", "--all-features"])
    if proc.returncode != 0:
        raise RuntimeError("cargo metadata failed:\n" + proc.stderr.decode("utf-8", "replace"))
    meta = json.loads(proc.stdout)
    packages = {p["id"]: p for p in meta["packages"]}
    nodes = {n["id"]: n for n in meta["resolve"]["nodes"]}
    members = set(meta["workspace_members"])
    # Runtime and build edges only, like `cargo tree -e normal,build`.
    reachable = set()
    stack = list(members)
    while stack:
        current = stack.pop()
        if current in reachable:
            continue
        reachable.add(current)
        for dep in nodes[current]["deps"]:
            if any(kind["kind"] in (None, "build") for kind in dep["dep_kinds"]):
                stack.append(dep["pkg"])
    dependents = collections.defaultdict(set)
    for current in reachable:
        for dep in nodes[current]["deps"]:
            if dep["pkg"] in reachable and any(kind["kind"] in (None, "build") for kind in dep["dep_kinds"]):
                dependents[dep["pkg"]].add(packages[current]["name"])
    return packages, members, reachable, dependents


def check_deps(_allow):
    result = Result("deps", "Dependency graph (9.3)")
    packages, members, reachable, dependents = load_graph()
    bans = parse_deny_bans()

    workspace = sorted(p["name"] for i, p in packages.items() if i in members)
    for name in workspace:
        for banned in BANNED_WORKSPACE_PACKAGES:
            if fnmatch.fnmatch(name, banned):
                result.add(None, None, "workspace crate `%s` must not exist" % name)
                break

    for package_id in sorted(reachable, key=lambda i: (packages[i]["name"], packages[i]["version"])):
        package = packages[package_id]
        name = package["name"]
        if name not in bans:
            continue
        wrappers = bans[name]
        who = sorted(dependents[package_id])
        label = "%s %s" % (name, package["version"])
        if wrappers is None:
            result.add(None, None, "banned crate `%s` is in the graph, used by: %s" % (label, ", ".join(who) or "(workspace root)"))
        else:
            extra = [d for d in who if d not in wrappers]
            if extra:
                result.add(
                    None, None,
                    "`%s` is used by crates outside its wrappers %s: %s" % (label, wrappers, ", ".join(extra)),
                )
    return result


def check_deny(_allow):
    result = Result("deny", "cargo deny check bans licenses sources (9.3)")
    if shutil.which("cargo-deny") is None:
        result.findings.append(Finding(None, None, "cargo-deny is not installed (cargo install --locked cargo-deny)"))
        return result
    proc = run(["cargo", "deny", "--locked", "--format", "json", "check", "bans", "licenses", "sources"])
    seen = set()
    for raw in proc.stderr.decode("utf-8", "replace").splitlines():
        try:
            entry = json.loads(raw)
        except ValueError:
            continue
        fields = entry.get("fields", {})
        if entry.get("type") != "diagnostic" or fields.get("severity") != "error":
            continue
        message = "[%s] %s" % (fields.get("code", "error"), fields.get("message", ""))
        if message not in seen:
            seen.add(message)
            result.add(None, None, message)
    if proc.returncode != 0 and not result.findings:
        result.add(None, None, "cargo deny failed: " + proc.stderr.decode("utf-8", "replace").strip()[-400:])
    return result


# --- 9.4a: strace log ----------------------------------------------------------------------

MACOS_SANDBOX_HEADER = "# openrun-offline-sandbox-macos 1"

# A line of `log stream --predicate 'eventMessage CONTAINS "Sandbox"'`: the kernel reporting that a
# sandbox profile denied an operation, optionally coalesced ("3 duplicate reports for ...").
MACOS_DENIAL = re.compile(r"Sandbox: (?P<name>.+?)\((?P<pid>\d+)\) deny\(\d+\) (?P<op>\S+) ?(?P<detail>.*)$")

# Processes outside the sandboxed command whose own profiles deny network access now and then.
# The kernel logs their denials in the same stream; a denial by a process that is not in the
# command's tree and not listed here fails the audit, so a new name shows up as a failure to look
# at, not as a pass. Measured on the macos-latest runner (see CHANGES.md, "macOS offline proof").
MACOS_SANDBOX_NOISE = frozenset(["languageassetd", "nsattributedstringagent", "voicebankingd"])


def macos_denial_violation(op, detail):
    """Why a denial counts as an attempt to reach the network, or None."""
    if op == "network-outbound":
        if detail.startswith("remote:"):
            return "connection to a non-local address (%s)" % detail
        return "network access (%s)" % detail
    if op == "mach-lookup" and (detail.startswith("com.apple.dnssd") or detail.startswith("com.apple.nsurlsessiond")):
        return "request to a system network service (%s)" % detail
    return None


def check_net_log_macos(path, lines, result):
    """The log of script/offline_sandbox_macos: a header, the processes of the command, then the
    unified-log stream of sandbox reports, then `# end`."""
    meta = {"canary": None, "end": False, "canaries": set()}
    tree_pids = set()
    tree_names = set()
    for raw in lines:
        text = raw.rstrip("\n")
        if text.startswith("# canary: seen pid "):
            meta["canary"] = text[len("# canary: seen pid "):].strip()
        elif text.startswith("# canary-pid: "):
            meta["canaries"].add(text[len("# canary-pid: "):].strip())
        elif text.startswith("# tree: "):
            fields = text[len("# tree: "):].split(None, 1)
            if fields:
                tree_pids.add(fields[0])
                if len(fields) > 1:
                    tree_names.add(fields[1].strip("()")[:15])
        elif text == "# end":
            meta["end"] = True
    if meta["canary"] is None:
        result.add(path, None, "no canary: the sandbox did not show that it records denials")
    if not meta["end"]:
        result.add(path, None, "incomplete: the run did not finish writing the log (no `# end`)")
    for number, raw in enumerate(lines, 1):
        if raw.startswith("#"):
            continue
        if "Messages dropped" in raw:
            result.add(path, number, "the log stream dropped messages: denials may be missing from this log")
            continue
        match = MACOS_DENIAL.search(raw)
        if not match:
            continue
        reason = macos_denial_violation(match.group("op"), match.group("detail").strip())
        if not reason:
            continue
        pid = match.group("pid")
        name = match.group("name")
        if pid == meta["canary"] or pid in meta["canaries"]:
            continue
        if pid not in tree_pids and name[:15] not in tree_names and name in MACOS_SANDBOX_NOISE:
            continue
        result.add(path, number, "%s(%s): %s" % (name, pid, reason))


def check_net_log(path):
    result = Result("netlog", "Sandboxed run: refused network accesses in %s (9.4a)" % path)
    if not os.path.isfile(path):
        # `script/offline_sandbox_macos` writes the log when its command has ended. No file means
        # the step did not get that far (it hung, was cancelled or never started), so nothing is
        # known about the network accesses it made: that is a failure, not "no connections".
        result.add(path, None, "log missing: the sandboxed step that writes it did not run to completion")
        return result
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    if not lines or not lines[0].startswith("# openrun-offline-sandbox-macos"):
        result.add(path, 1, "not a log of script/offline_sandbox_macos (the header line is missing)")
        return result
    if lines[0].rstrip("\n") != MACOS_SANDBOX_HEADER:
        result.add(path, 1, "unknown log format version: " + lines[0].strip())
        return result
    check_net_log_macos(path, lines, result)
    return result


