         {"app/src/terminal/model/session/command_executor/remote_command_executor.rs": 'None => Command::new("ssh"),\n',
          "app/src/terminal/ssh/util.rs": 'let mut command = String::from("sftp ");\n'}, "pass"),
        ("reviewed build bootstrap script", {"script/install_rust": "curl https://sh.rustup.rs | sh\n"}, "pass"),
    ]


MAC_HEADER = MACOS_SANDBOX_HEADER + "\n# command: cargo nextest run\n"
MAC_CANARY = "# canary: seen pid 77\n# tree: 500 integration\n# tree: 501 sandbox-exec\n# stream:\n"
MAC_END = "# end\n"


def mac_denial(name, pid, rest):
    return "2026-10-02 02:08:18.959121-0500 0x594b02e  Error  0x0  0  0  kernel: (Sandbox) Sandbox: %s(%d) deny(1) %s\n" % (name, pid, rest)


