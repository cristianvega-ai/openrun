def self_test_dependency_cases(base):
    """Fixture git dependencies: (name, directory files, policy files, expectation)."""
    generators = "command-signatures/src/generators"
    classified = 'pub(super) const X: &[(&str, &str)] = &[\n    ("spec", "known"),\n];\n'
    unclassified = 'pub(super) const X: &[(&str, &str)] = &[\n    ("spec", "other"),\n];\n'
    add_known = 'CommandSignatureGenerators::new("spec").add_generator(\n    "known",\n    Generator::script(x, y),\n)\n'
    return [
        ("dependency with a curl command",
         "fixture-dep", {"src/lib.rs": 'let c = "curl -s https://example.invalid";\n'}, None, "fail"),
        ("dependency with a network crate", "fixture-dep", {"src/lib.rs": "use reqwest::Client;\n"}, None, "fail"),
        ("build-generated directory of a dependency", "fixture-dep",
         {"src/generated_workflows/x.rs": 'let c = "curl -s https://example.invalid";\n'}, None, "pass"),
        ("dependency without network code", "fixture-dep", {"src/lib.rs": "pub fn add(a: u32) -> u32 { a }\n"}, None, "pass"),
        ("generator that is not classified", GENERATOR_DEP,
         {generators + "/spec.rs": add_known}, {"allowed.rs": unclassified, "denied.rs": "\n"}, "fail"),
        ("classified generator", GENERATOR_DEP,
         {generators + "/spec.rs": add_known}, {"allowed.rs": classified, "denied.rs": "\n"}, "pass"),
        ("generator with a new URL", GENERATOR_DEP,
         {generators + "/spec.rs": add_known + 'let u = "https://example.invalid/list";\n'},
         {"allowed.rs": classified, "denied.rs": "\n"}, "fail"),
    ]


def write_files(root, files):
    for relative, content in files.items():
        path = os.path.join(root, relative)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)


def run_self_test(allowlist_path):
    """Runs the checks against fixture trees, with the real allowlist. Returns 1 if any case differs."""
    import tempfile

    global ROOT
    real_root = ROOT
    with open(allowlist_path, encoding="utf-8") as f:
        real_lines = f.read().splitlines()
    lines = [line for line in real_lines if not line.startswith("binary-pin ")]
    failures = []
    total = 0

    def report(name, expectation, findings):
        nonlocal total
        total += 1
        good = bool(findings) if expectation == "fail" else not findings
        print("  %-4s %-58s %s" % ("ok" if good else "FAIL", name, "%d finding(s)" % len(findings)))
        if not good:
            failures.append(name)
            for finding in findings[:5]:
                print("         %s:%s %s" % (finding.path, finding.line, finding.text))

    try:
        for name, files, expectation in self_test_cases():
            with tempfile.TemporaryDirectory() as tree:
                ROOT = tree
                write_files(tree, files)
                allow = Allowlist(lines=lines)
                findings = check_hosts(allow).findings + check_network(allow).findings
                report(name, expectation, findings)

        for name, log, expectation in self_test_net_log_cases():
            with tempfile.TemporaryDirectory() as tree:
                path = os.path.join(tree, "net.log")
                if log is not None:
                    with open(path, "w", encoding="utf-8") as f:
                        f.write(log)
                report(name, expectation, check_net_log(path).findings)

        for name, package, files, policy, expectation in self_test_dependency_cases(None):
            with tempfile.TemporaryDirectory() as tree:
                ROOT = tree
                dependency = os.path.join(tree, "dep")
                write_files(dependency, files)
                policy_dir = os.path.join(tree, "policy")
                write_files(policy_dir, policy or {})
                allow = Allowlist(lines=lines)
                report(name, expectation, check_dependency_sources(allow, [(package, dependency)], policy_dir).findings)

        for name, content, expectation in [
            ("pinned binary with the pinned hash", b"pinned content", "pass"),
            ("pinned binary with other content", b"other content", "fail"),
        ]:
            with tempfile.TemporaryDirectory() as tree:
                ROOT = tree
                digest = hashlib.sha256(b"pinned content").hexdigest()
                os.makedirs(os.path.join(tree, "bin"))
                with open(os.path.join(tree, "bin", "tool.dll"), "wb") as f:
                    f.write(content + b" https://app.warp.dev\n")
                digest = hashlib.sha256(b"pinned content https://app.warp.dev\n").hexdigest()
                allow = Allowlist(lines=["binary-pin | bin/tool.dll | %s | fixture" % digest])
                report(name, expectation, check_hosts(allow).findings)
    finally:
        ROOT = real_root

    print("%d self-test case(s), %d failed" % (total, len(failures)))
    return 1 if failures else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--report", action="store_true", help="list findings and exit 0")
    parser.add_argument("--summary", action="store_true", help="per-file counts instead of every line")
    parser.add_argument("--review", action="store_true", help="also print the informational lists in full")
    parser.add_argument("--only", help="comma-separated groups to run: " + ", ".join(GROUPS))
    parser.add_argument("--include-comments", action="store_true", help="count comment lines in the network check")
    parser.add_argument("--skip-deny", action="store_true", help="do not run cargo deny")
    parser.add_argument("--net-log", metavar="FILE", nargs="+", help="check strace logs instead of the tree")
    parser.add_argument("--self-test", action="store_true", help="run the checks against fixture trees")
    parser.add_argument("--allowlist", default=DEFAULT_ALLOWLIST, help="allowlist file")
    args = parser.parse_args()
    global INCLUDE_COMMENTS
    INCLUDE_COMMENTS = args.include_comments

    if args.self_test:
        return run_self_test(args.allowlist)

    if args.net_log:
        results = [check_net_log(path) for path in args.net_log]
        for result in results:
            print_result(result, args.summary)
        return 0 if args.report or not any(result.findings for result in results) else 1

    if shutil.which("rg") is None:
        print("error: ripgrep (rg) is required", file=sys.stderr)
        return 2

    groups = list(GROUPS)
    if args.only:
        groups = [g.strip() for g in args.only.split(",")]
        unknown = [g for g in groups if g not in GROUPS]
        if unknown:
            parser.error("unknown group(s): " + ", ".join(unknown))

    allow = Allowlist(args.allowlist)
    results = []
    for group in groups:
        for check in GROUPS[group]:
            if check is check_deny and args.skip_deny:
                continue
            try:
                results.append(check(allow))
            except RuntimeError as error:
                print("error: %s" % error, file=sys.stderr)
                return 2

    for result in results:
        print_result(result, args.summary or (not result.blocking and not args.review))
    print_areas(results)

    if "hosts" in groups and "network" in groups:
        stale = Result("allowlist", "Allowlist entries that matched nothing (remove them)")
        for check, glob, number in allow.unused():
            stale.add(None, None, "%s:%d  %s | %s" % (os.path.relpath(args.allowlist, ROOT), number, check, glob))
        results.append(stale)
        print_result(stale, args.summary)

    blocking = [r for r in results if r.blocking and r.findings]
    print("== summary")
    for result in results:
        state = "FAIL" if result.blocking and result.findings else ("info" if not result.blocking else "ok")
        print("   %-9s %-5s %6d findings" % (result.check_id, state, len(result.findings)))
    if blocking and not args.report:
        print("\noffline audit FAILED: %s" % ", ".join(r.check_id for r in blocking))
        return 1
    if blocking:
        print("\nreport mode: exiting 0 with %d failing check(s)" % len(blocking))
    else:
        print("\noffline audit passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
