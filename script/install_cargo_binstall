#!/usr/bin/env bash
#
# Installs cargo-binstall at the pinned version if it isn't already present.

set -eo pipefail

# Local bootstraps and CI both install binstall through this script, so this is
# the single pinned version everywhere.
BINSTALL_VERSION="1.18.1"

# Every archive this script may run, keyed by asset name, with the SHA-256 that
# GitHub publishes for it. The download URL and the release it points at are both
# mutable, so the digest — reviewed here, in the repo — is what authenticates the
# binary before it executes. A mismatch aborts the install.
#
# Regenerate when bumping BINSTALL_VERSION:
#
#   curl -sSfL https://api.github.com/repos/cargo-bins/cargo-binstall/releases/tags/v<version> \
#     | jq -r '.assets[] | "\(.name) \(.digest)"'
archive_sha256() {
    case "$1" in
        cargo-binstall-universal-apple-darwin.zip)
            echo "5cc5d6d502924623a491c4ed77fb925193f05106252cffd3be979cbb94a0cd01" ;;
    esac
}

# The macOS archive is a universal binary, so it serves both darwin architectures.
archive_for_platform() {
    if [ "$(uname -s)" = "Darwin" ]; then
        echo "cargo-binstall-universal-apple-darwin.zip"
    fi
}

sha256_of() {
    if [ -n "$(command -v sha256sum || true)" ]; then
        sha256sum "$1" | cut -d ' ' -f 1
    elif [ -n "$(command -v shasum || true)" ]; then
        shasum -a 256 "$1" | cut -d ' ' -f 1
    else
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    fi
}

# bsdtar reads zip archives, which keeps unzip optional on macOS.
extract() {
    if [ -n "$(command -v unzip || true)" ]; then
        unzip -o "$1"
    else
        tar -xf "$1"
    fi
}

# cargo-binstall is installed from its own prebuilt release rather than with
# `cargo install`, which compiles it and its whole dependency tree from source and
# dominates the runtime of a fresh bootstrap.
INSTALLED_VERSION=""
if command -v cargo-binstall; then
    INSTALLED_VERSION="$(cargo-binstall -V)"
fi

if [ "$INSTALLED_VERSION" != "$BINSTALL_VERSION" ]; then
    echo "Installing cargo-binstall v${BINSTALL_VERSION} from its prebuilt release..."

    ARCHIVE="$(archive_for_platform)"
    EXPECTED_SHA256="$(archive_sha256 "$ARCHIVE")"
    if [ -z "$EXPECTED_SHA256" ]; then
        echo "error: no pinned cargo-binstall release for $(uname -s) $(uname -m)." >&2
        echo "Add its archive and SHA-256 to script/install_cargo_binstall to support this platform." >&2
        exit 1
    fi

    WORKDIR="$(mktemp -d)"
    # shellcheck disable=SC2064 # Expand WORKDIR now so the trap still resolves it later.
    trap "rm -rf \"$WORKDIR\"" EXIT

    # GitHub's release-asset CDN intermittently fails with errors curl's --retry
    # won't retry, and its brownouts can last minutes, so retry at the shell level
    # with exponential backoff.
    DOWNLOAD_ATTEMPTS=5
    RETRY_DELAY=10
    for attempt in $(seq 1 "$DOWNLOAD_ATTEMPTS"); do
        if curl -L --proto '=https' --tlsv1.2 -sSf \
            --retry 5 --retry-delay 2 \
            "https://github.com/cargo-bins/cargo-binstall/releases/download/v${BINSTALL_VERSION}/${ARCHIVE}" \
            --output "$WORKDIR/$ARCHIVE"; then
            break
        fi
        if [ "$attempt" -eq "$DOWNLOAD_ATTEMPTS" ]; then
            echo "error: failed to download $ARCHIVE after $DOWNLOAD_ATTEMPTS attempts." >&2
            exit 1
        fi
        echo "Download failed; retrying in ${RETRY_DELAY}s..." >&2
        sleep "$RETRY_DELAY"
        RETRY_DELAY=$((RETRY_DELAY * 2))
    done

    ACTUAL_SHA256="$(sha256_of "$WORKDIR/$ARCHIVE")"
    if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
        echo "error: $ARCHIVE failed verification, refusing to run it." >&2
        echo "  expected SHA-256 $EXPECTED_SHA256" >&2
        echo "  actual SHA-256   $ACTUAL_SHA256" >&2
        exit 1
    fi

    (cd "$WORKDIR" && extract "$ARCHIVE")

    BINSTALL="$WORKDIR/cargo-binstall"
    chmod +x "$BINSTALL"
    "$BINSTALL" --self-install
fi
