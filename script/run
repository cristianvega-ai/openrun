#!/bin/bash
#
# Entrypoint for running a local build.
#
# Always builds the `warp-oss` binary. It delegates to `./script/macos/run`, which builds and
# runs the app as a real `.app` bundle (with code signing, plist updates, etc.).
#
# This script owns the argument parsing and passes the resolved cargo features to the macOS
# script via the FEATURES environment variable.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

OS_TYPE="$(uname -s)"

FEATURES=""

# Argument parsing. macOS-specific flags (--dont-open, --open_with_launchd,
# --generate-schema) are forwarded through MAC_ARGS.
MAC_ARGS=()
WARP_ARGS=()

while (( "$#" )); do
  case "$1" in
    --)
      shift
      WARP_ARGS=("$@")
      break
      ;;
    --features)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        FEATURES="${FEATURES:+$FEATURES,}$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --release)
      MAC_ARGS+=("$1")
      shift
      ;;
    --profile)
      if [ -n "$2" ] && [ "${2:0:1}" != "-" ]; then
        MAC_ARGS+=("$1" "$2")
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    *)
      # Unknown flags (including --dont-open) and any positional arguments are forwarded to
      # the macOS script.
      MAC_ARGS+=("$1")
      shift
      ;;
  esac
done

export FEATURES

if [[ "$OS_TYPE" != "Darwin" ]]; then
  echo "Only macOS is supported ($OS_TYPE)." >&2
  exit 1
fi

if [[ ${#WARP_ARGS[@]} -gt 0 ]]; then
  exec ./script/macos/run "${MAC_ARGS[@]}" -- "${WARP_ARGS[@]}"
else
  exec ./script/macos/run "${MAC_ARGS[@]}"
fi
